# OpenRouter credentials
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional metadata sent to OpenRouter
OPENROUTER_SITE_URL=https://github.com/tech_team
OPENROUTER_APP_NAME=tech_team

# Optional model overrides (OpenRouter model slugs). Any role omitted uses the
# sensible default in orchestrator/llm.py. Set a single one to apply everywhere.
# OPENROUTER_MODEL=openai/gpt-4o-mini
# MODEL_PM=openai/gpt-4o
# MODEL_CODE_LEAD=anthropic/claude-3.5-sonnet
# MODEL_SENIOR_BACKEND=openai/gpt-4o-mini
# MODEL_FRONTEND=openai/gpt-4o-mini
# MODEL_JUNIOR1=openai/gpt-4o-mini
# MODEL_JUNIOR2=openai/gpt-4o-mini
# MODEL_QA=openai/gpt-4o-mini
